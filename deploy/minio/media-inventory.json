{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::media"],
      "Condition": {"StringEquals": {"s3:prefix": ["originals/", "variants/"]}}
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::media-quarantine"],
      "Condition": {"StringEquals": {"s3:prefix": ["uploads/"]}}
    }
  ]
}
