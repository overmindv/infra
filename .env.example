# Эти значения автоматически генерирует `make up`; вручную их заполнять не нужно.
BOOTSTRAP_SUPERUSER_PASSWORD=98754dd033b152bb4a887141990259624f2861a792d86e33ecb0b7705d87a20a
LOCAL_UID=501
LOCAL_GID=20

# Kafka работает в KRaft-режиме без ZooKeeper.
KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_REQUESTS_TOPIC=code-execution.requests.v1
KAFKA_RESULTS_TOPIC=code-execution.results.v1
KAFKA_RESULTS_CONSUMER_GROUP=tasks-code-results-v1
KAFKA_TOPIC_PARTITIONS=3
KAFKA_RETENTION_MS=604800000
KAFKA_OUTBOX_POLL_INTERVAL=500ms

# Локальная учётная запись администратора; пароль покажет `make credentials`.
BOOTSTRAP_SUPERUSER_EMAIL=admin@overmindv.com
BOOTSTRAP_SUPERUSER_USERNAME=superadmin

# Telegram по умолчанию выключен и не мешает запуску основного стека.
# Для включения получите API ID/hash на https://my.telegram.org/apps и прочитайте README.
TASK_HUNTER_TELEGRAM_ENABLED=false
TASK_HUNTER_TELEGRAM_API_ID=
TASK_HUNTER_TELEGRAM_API_HASH=
TASK_HUNTER_TELEGRAM_CHANNELS=analytic_postupashki,postupashki_ml,algoses

# Сервисы:
#   frontend
FRONTEND_PORT=3000
#   api-gateway
API_GATEWAY_PORT=8081
#   users
USERS_POSTGRES_PORT=5432
USERS_POSTGRES_DB=users
USERS_POSTGRES_USER=postgres
USERS_POSTGRES_PASSWORD=users-postgres-password
JWT_SECRET=47a78a0fa67e52c1226858266f4365d48b2ff12afea04d94a54bb34d2606aba3
#   entities
ENTITIES_PORT=8082
ENTITIES_POSTGRES_PORT=5433
ENTITIES_POSTGRES_PASSWORD=entities-postgres-password
#   tasks
TASKS_POSTGRES_PORT=5434
TASKS_POSTGRES_PASSWORD=tasks-postgres-password
TASKS_READ_TIMEOUT=10s
TASKS_WRITE_TIMEOUT=20s
TASKS_TIMEOUT=5s
CODE_EXECUTION_TIME_LIMIT=1s
CODE_EXECUTION_MEMORY_LIMIT_BYTES=67108864
#   task-hunter
TASK_HUNTER_POSTGRES_PASSWORD=task-hunter-postgres-password
TASK_HUNTER_INGEST_TOKEN=2fac802e114cd2208ac4f32f3740eed4b4c454e313fc23444037506976eaee56
TASK_HUNTER_GATEWAY_TOKEN=6bf58401d76bd1d9449507bfb96ec529b78b62a7a487b1bb612c957a9a274f4b
TASK_HUNTER_CRON=0 */6 * * *
TASK_HUNTER_DEFAULT_LIMIT=100

# Публичный Reader fallback для Codeforces; API-ключ не нужен.
TASK_HUNTER_CODEFORCES_READER_URL=https://r.jina.ai/http://codeforces.com
TASK_HUNTER_TIMEOUT=10s
#   content
CONTENT_POSTGRES_PORT=5436
CONTENT_POSTGRES_PASSWORD=content-postgres-password
CONTENT_GRPC_PORT=9090
CONTENT_KAFKA_ENABLED=true
#   media
MEDIA_PORT=8085
MEDIA_POSTGRES_PORT=5435
MEDIA_POSTGRES_PASSWORD=media-postgres-password
MEDIA_GATEWAY_TOKEN=replace-with-random-media-gateway-token
MEDIA_USERS_TOKEN=replace-with-random-media-users-token
# Только для совместимости со старыми локальными .env; новые окружения используют два token выше.
MEDIA_INTERNAL_TOKEN=
MEDIA_USER_QUOTA_BYTES=5368709120
MEDIA_MAX_AVATAR_BYTES=5242880
MEDIA_MAX_AVATAR_PIXELS=12000000
MEDIA_TIMEOUT=10s
USERS_WORKER_POLL_INTERVAL=1s
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-random-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CLAMAV_IMAGE=clamav/clamav:1.4_base
# Официальные pinned mc/ClamAV images запускаются через Docker Desktop emulation на ARM Mac.
MEDIA_TOOL_PLATFORM=linux/amd64
JWT_ISSUER=users
JWT_TTL=24h
USERS_TIMEOUT=5s
ADMIN_USER_IDS=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
IMAGE_REGISTRY=overmindv
IMAGE_TAG=local
KIND_CLUSTER=overmindv
