# Эти значения автоматически генерирует `make up`; вручную их заполнять не нужно.
USERS_POSTGRES_PASSWORD=__GENERATE__
ENTITIES_POSTGRES_PASSWORD=__GENERATE__
TASKS_IT_POSTGRES_PASSWORD=__GENERATE__
TASK_HUNTER_POSTGRES_PASSWORD=__GENERATE__
TASK_HUNTER_INGEST_TOKEN=__GENERATE__
TASK_HUNTER_GATEWAY_TOKEN=__GENERATE__
JWT_SECRET=__GENERATE__
BOOTSTRAP_SUPERUSER_PASSWORD=__GENERATE__
LOCAL_UID=__LOCAL_UID__
LOCAL_GID=__LOCAL_GID__

# Kafka работает в KRaft-режиме без ZooKeeper. Cluster ID не является секретом,
# но должен оставаться неизменным, пока используется volume kafka-data.
KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_REQUESTS_TOPIC=code-execution.requests.v1
KAFKA_RESULTS_TOPIC=code-execution.results.v1
KAFKA_TOPIC_PARTITIONS=3
KAFKA_RETENTION_MS=604800000

# Локальная учётная запись администратора; пароль покажет `make credentials`.
BOOTSTRAP_SUPERUSER_EMAIL=admin@overmindv.local
BOOTSTRAP_SUPERUSER_USERNAME=superadmin

# Telegram по умолчанию выключен и не мешает запуску основного стека.
# Для включения получите API ID/hash на https://my.telegram.org/apps и прочитайте README.
TASK_HUNTER_TELEGRAM_ENABLED=false
TASK_HUNTER_TELEGRAM_API_ID=
TASK_HUNTER_TELEGRAM_API_HASH=
TASK_HUNTER_TELEGRAM_CHANNELS=analytic_postupashki,postupashki_ml,algoses

# Обычно эти настройки менять не требуется.
USERS_POSTGRES_DB=users
USERS_POSTGRES_USER=postgres
USERS_POSTGRES_PORT=5432
ENTITIES_POSTGRES_PORT=5433
ENTITIES_PORT=8082
TASKS_IT_POSTGRES_PORT=5434
API_GATEWAY_PORT=8081
FRONTEND_PORT=3000
ENTITIES_LOG_LEVEL=debug
TASKS_IT_LOG_LEVEL=debug
TASKS_IT_READ_TIMEOUT=10s
TASKS_IT_WRITE_TIMEOUT=20s
TASKS_IT_TIMEOUT=5s
TASK_HUNTER_CRON=0 */6 * * *
TASK_HUNTER_DEFAULT_LIMIT=100
# Публичный Reader fallback для Codeforces; API-ключ не нужен.
TASK_HUNTER_CODEFORCES_READER_URL=https://r.jina.ai/http://codeforces.com
TASK_HUNTER_TIMEOUT=10s
JWT_ISSUER=users
JWT_TTL=24h
USERS_TIMEOUT=5s
ADMIN_USER_IDS=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
IMAGE_REGISTRY=overmindv
IMAGE_TAG=local
KIND_CLUSTER=overmindv
